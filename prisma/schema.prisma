generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  role             String?
  banned           Boolean?
  banReason        String?
  banExpires       DateTime?
  feedbacks        Feedback[]
  discussions      Discussion[]
  comments         Comment[]
  stripeCustomerId String?

  discussionVotes   DiscussionVote[]
  discussionReports DiscussionReport[]
  commentVotes      CommentVote[]
  notifications     Notification[]

  ownedTeams        Team[]            @relation("TeamOwner")
  teamMemberships   TeamMember[]
  digestApprovals   DigestApproval[]

  @@unique([email])
  @@map("user")
}

model Notification {
  id          String   @id @default(cuid())
  title       String
  description String?
  link        String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification")
}

model Discussion {
  id               String             @id @default(cuid())
  title            String
  content          String             @db.Text
  isPublic         Boolean            @default(true)
  isSeo            Boolean            @default(false)
  isLocked         Boolean            @default(false)
  lockReason       String?
  sourceFeedbackId String?
  views            Int                @default(0)
  userId           String
  user             User               @relation(fields: [userId], references: [id])
  comments         Comment[]
  votes            DiscussionVote[]
  reports          DiscussionReport[]
  discussionViews  DiscussionView[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  feedback         Feedback?

  @@map("discussion")
}

model DiscussionVote {
  id           String     @id @default(cuid())
  type         String // UPVOTE or DOWNVOTE
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@unique([userId, discussionId])
  @@map("discussion_vote")
}

model DiscussionReport {
  id           String     @id @default(cuid())
  reason       String
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@map("discussion_report")
}

model DiscussionView {
  id           String     @id @default(cuid())
  userId       String?
  ipAddress    String?
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@map("discussion_view")
}

model Comment {
  id              String        @id @default(cuid())
  content         String        @db.Text
  discussionId    String
  discussion      Discussion    @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  votes           CommentVote[]
  isHighlighted   Boolean       @default(false)
  parentCommentId String?
  parentComment   Comment?      @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies         Comment[]     @relation("CommentReplies")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("comment")
}

model CommentVote {
  id        String  @id @default(cuid())
  type      String // UPVOTE or DOWNVOTE
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("comment_vote")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Feedback {
  id           String          @id @default(cuid())
  email        String
  text         String          @db.Text
  source       String?
  status       String          @default("pending") // pending, replied
  userId       String?
  images       String[]        @default([])
  replies      FeedbackReply[]
  user         User?           @relation(fields: [userId], references: [id])
  discussionId String?         @unique
  discussion   Discussion?     @relation(fields: [discussionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("feedback")
}

model FeedbackReply {
  id         String   @id @default(cuid())
  feedbackId String
  text       String
  images     String[] @default([])
  createdAt  DateTime @default(now())
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@map("feedback_reply")
}

model FeedbackNotificationEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("feedback_notification_email")
}

// ── FBM Digest Models ──────────────────────────────────────────

enum PublishDay {
  MONDAY
  WEDNESDAY
  FRIDAY
}

enum DigestStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  FAILED
}

enum ArticleSetStatus {
  EMPTY
  GENERATING
  GENERATED
  EDITED
}

enum ArticleStatus {
  EMPTY
  GENERATED
  EDITED
  APPROVED
}

enum ResearchRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

enum ResearchPromptType {
  RESEARCH
  WRITING
}

// ── Knowledge Base ────────────────────────────────────────────

model KnowledgeBase {
  id             String     @id @default(cuid())
  teamId         String?
  team           Team?      @relation(fields: [teamId], references: [id])
  name           String
  brandVoice     String     @db.Text
  sourceUrls     String[]   @default([])
  previousTopics String[]   @default([])
  researches     Research[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("knowledge_base")
}

// ── Research Pipeline ─────────────────────────────────────────

model Research {
  id               String            @id @default(cuid())
  teamId           String?
  team             Team?             @relation(fields: [teamId], references: [id])
  knowledgeBaseId  String
  knowledgeBase    KnowledgeBase     @relation(fields: [knowledgeBaseId], references: [id])
  name             String
  description      String?
  searchWindowDays Int               @default(10)
  minFindings      Int               @default(15)
  reRunOnFailure   Boolean           @default(true)
  sectionTemplates SectionTemplate[]
  prompts          ResearchPrompt[]
  runs             ResearchRun[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("research")
}

model SectionTemplate {
  id              String    @id @default(cuid())
  researchId      String
  research        Research  @relation(fields: [researchId], references: [id], onDelete: Cascade)
  name            String
  key             String
  description     String?
  order           Int
  findingCategory String
  promptTemplate  String    @db.Text
  isActive        Boolean   @default(true)
  articles        Article[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([researchId, key])
  @@map("section_template")
}

model ResearchPrompt {
  id         String             @id @default(cuid())
  researchId String
  research   Research           @relation(fields: [researchId], references: [id], onDelete: Cascade)
  type       ResearchPromptType
  name       String
  content    String             @db.Text
  isActive   Boolean            @default(true)
  version    Int                @default(1)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@map("research_prompt")
}

model ResearchRun {
  id               String            @id @default(cuid())
  researchId       String
  research         Research          @relation(fields: [researchId], references: [id], onDelete: Cascade)
  status           ResearchRunStatus @default(PENDING)
  promptUsed       String?           @db.Text
  searchWindowDays Int
  startedAt        DateTime?
  completedAt      DateTime?
  findings         ResearchFinding[]
  articleSets      ArticleSet[]
  error            String?           @db.Text
  createdAt        DateTime          @default(now())

  @@index([status])
  @@map("research_run")
}

model ResearchFinding {
  id          String      @id @default(cuid())
  runId       String
  run         ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  order       Int
  category    String
  title       String
  summary     String      @db.Text
  sourceUrl   String
  sourceTitle String?
  sourceDate  DateTime?
  used        Boolean     @default(false)
  article     Article?
  createdAt   DateTime    @default(now())

  @@map("research_finding")
}

// ── Digest & Articles ─────────────────────────────────────────

model Digest {
  id             String       @id @default(cuid())
  digestNumber   Int          @unique
  title          String?
  subjectLine    String?
  preHeader      String?
  publishDay     PublishDay
  publishDate    DateTime
  status         DigestStatus @default(DRAFT)
  personalNote   String?      @db.Text
  googleDocUrl   String?
  clickFunnelsId String?
  teamId         String?
  team           Team?        @relation(fields: [teamId], references: [id])
  articleSet     ArticleSet?
  approvals      DigestApproval[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  publishedAt    DateTime?

  @@index([status])
  @@index([publishDay])
  @@index([publishDate])
  @@map("digest")
}

model ArticleSet {
  id        String           @id @default(cuid())
  runId     String?
  run       ResearchRun?     @relation(fields: [runId], references: [id])
  digestId  String           @unique
  digest    Digest           @relation(fields: [digestId], references: [id], onDelete: Cascade)
  status    ArticleSetStatus @default(EMPTY)
  articles  Article[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("article_set")
}

model Article {
  id                String           @id @default(cuid())
  articleSetId      String
  articleSet        ArticleSet       @relation(fields: [articleSetId], references: [id], onDelete: Cascade)
  sectionTemplateId String?
  sectionTemplate   SectionTemplate? @relation(fields: [sectionTemplateId], references: [id])
  order             Int
  heading           String?
  body              String?          @db.Text
  sourceUrl         String?
  sourceTitle       String?
  sourceDate        DateTime?
  findingId         String?          @unique
  finding           ResearchFinding? @relation(fields: [findingId], references: [id])
  status            ArticleStatus    @default(EMPTY)
  generatedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([articleSetId, sectionTemplateId])
  @@map("article")
}

// ── Teams & Approvals ─────────────────────────────────────────

model Team {
  id        String       @id @default(cuid())
  name      String
  ownerId   String
  owner     User         @relation("TeamOwner", fields: [ownerId], references: [id])
  members        TeamMember[]
  digests        Digest[]
  knowledgeBases KnowledgeBase[]
  researches     Research[]
  createdAt      DateTime        @default(now())
  updatedAt DateTime     @updatedAt

  @@map("team")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@map("team_member")
}

model DigestApproval {
  id         String    @id @default(cuid())
  digestId   String
  digest     Digest    @relation(fields: [digestId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String
  approved   Boolean   @default(false)
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([digestId, userId])
  @@map("digest_approval")
}

model Subscription {
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  id                   String    @id @default(cuid())
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String
  periodStart          DateTime?
  periodEnd            DateTime?
  cancelAtPeriodEnd    Boolean?
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  seats                Int?
  trialStart           DateTime?
  trialEnd             DateTime?

  @@map("subscription")
}
